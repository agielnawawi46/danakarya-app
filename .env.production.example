##############################################################
# FILE INI ADALAH TEMPLATE .env UNTUK DEPLOYMENT PRODUCTION  #
# Salin file ini ke .env di server, lalu isi nilai yang sesuai #
##############################################################

APP_NAME="Dana Karya"
APP_ENV=production
APP_KEY=          # Jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com   # Ganti dengan domain asli Anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=danakarya_db
DB_USERNAME=       # Isi username MySQL production
DB_PASSWORD=       # Isi password MySQL production

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com   # Ganti dengan domain Anda

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail (wajib dikonfigurasi untuk notifikasi) ─────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io        # Ganti dengan SMTP provider Anda
MAIL_PORT=587
MAIL_USERNAME=                    # Isi username SMTP
MAIL_PASSWORD=                    # Isi password SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
